{
  "name": "hades-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Hades AI Kernel — the platform every module plugs into (Phase 0).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hades": "npm run build && node dist/main.js",
    "online": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@tavily/core": "^0.7.6",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.17.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
